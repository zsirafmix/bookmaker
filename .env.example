# OpenAI API (Standard műfajokhoz: Fantasy, Thriller, Sci-Fi stb.)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter / Uncensored AI API (18+ Felnőtt, Pornó, Horror-pornó műfajokhoz)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Alternatív egyedi cenzúrázatlan végpont (opcionális):
# UNCENSORED_AI_BASE_URL=https://openrouter.ai/api/v1
# UNCENSORED_AI_MODEL=mistralai/mistral-large-2411

# Supabase / PostgreSQL kapcsolat (opcionális, fallback memória/JSON DB működik nélküle is)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
